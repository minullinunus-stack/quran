# Переменные для локальной разработки (wrangler dev).
# Скопируйте в .dev.vars и заполните. В продакшене используются секреты Cloudflare:
#   npx wrangler secret put BOT_TOKEN
#   npx wrangler secret put OWNER_ID
#   npx wrangler secret put WEBHOOK_SECRET

BOT_TOKEN=123456789:AA...ваш_токен
OWNER_ID=123456789
WEBHOOK_SECRET=любая_случайная_строка
